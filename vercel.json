{
  "version": 2,
  "builds": [
    { "src": "backend/server.js", "use": "@vercel/node" },
    { "src": "Frontend/**", "use": "@vercel/static" }
  ],
  "functions": {
    "backend/server.js": {
      "includeFiles": "backend/uploads/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/server.js" },
    { "src": "/uploads/(.*)", "dest": "backend/server.js" },
    { "src": "/$", "dest": "/Frontend/home.html" },
    { "src": "/(.*)", "dest": "/Frontend/$1" }
  ]
}
