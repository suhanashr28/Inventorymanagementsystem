# Copy this file to .env for local development. Do not commit a real .env file.
PORT=3000

# Database and authentication values
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
JWT_SECRET=

# Outbound email (Gmail example)
# Create a Google App Password (not your regular Gmail password) and remove its spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM="InventoryPro <your-sender@gmail.com>"
